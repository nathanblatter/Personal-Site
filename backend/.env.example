# Copy to .env.prod and fill in real values

# Set to "production" in .env.prod. When production, the app refuses to boot if
# JWT_SECRET / ADMIN_PASSWORD / MINIO secrets are left at defaults or empty.
ENVIRONMENT=development

TUNNEL_TOKEN=
JWT_SECRET=
ADMIN_USERNAME=nathan
ADMIN_PASSWORD=

# Login brute-force throttle (per IP). Defaults: 10 attempts / 900s.
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=900

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Existing KPI dashboard key
KPI_API_KEY=

# Umami analytics
UMAMI_BASE_URL=http://localhost:3333
UMAMI_WEBSITE_ID=
UMAMI_USERNAME=admin
UMAMI_PASSWORD=

# Health ingest endpoint
HEALTH_INGEST_API_KEY=your-secret-key-here
DATABASE_URL_KPI=postgresql://postgres:postgres@host.docker.internal:5432/kpi
