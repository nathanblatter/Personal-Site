# Copy to .env.prod and fill in real values

# Set to "production" in .env.prod. When production, the app refuses to boot if
# JWT_SECRET / ADMIN_PASSWORD / MINIO secrets are left at defaults or empty.
ENVIRONMENT=development

TUNNEL_TOKEN=
JWT_SECRET=
ADMIN_USERNAME=nathan
ADMIN_PASSWORD=

# Login brute-force throttle (per IP). Defaults: 10 attempts / 900s.
# Also applied to the Squawk passkey / email-code proxy endpoints.
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=900

# Admin sign-in through Squawk (Nathan's auth service). Leave SQUAWK_ISSUER empty
# locally and the username/password login above is used instead.
# Issuer base URL, no trailing slash (the hostname is configurable because it is
# being renamed auth. -> squawk.).
SQUAWK_ISSUER=
# The site's service id in Squawk (svc_...) — also the expected token audience.
SQUAWK_SERVICE_ID=
# Service credential (nbk_...) exchanged for service tokens (client_credentials).
SQUAWK_CREDENTIAL=
# First-party public OAuth client (nbc_..., PKCE, redirect_uri = SITE_URL/api/v1/auth/callback).
SQUAWK_CLIENT_ID=
# RFC 8707 resource registered on the service (https://nathanblatter.com/api).
SQUAWK_RESOURCE=
# Public origin of this site; builds the OAuth redirect_uri. Default https://nathanblatter.com
SITE_URL=
# Break-glass: keep the password login reachable even when Squawk is configured.
ADMIN_PASSWORD_LOGIN=false

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Existing KPI dashboard key
KPI_API_KEY=

# Umami analytics
UMAMI_BASE_URL=http://localhost:3333
UMAMI_WEBSITE_ID=
UMAMI_USERNAME=admin
UMAMI_PASSWORD=

# Health ingest endpoint
HEALTH_INGEST_API_KEY=your-secret-key-here
DATABASE_URL_KPI=postgresql://postgres:postgres@host.docker.internal:5432/kpi

# Daily voice journal
# Separate `journal` DB on the shared Postgres (auto-created on boot).
DATABASE_URL_JOURNAL=postgresql://postgres:postgres@host.docker.internal:5432/journal
# HMAC secret for the nightly magic link. Falls back to CHURCH_LINK_SECRET if unset.
JOURNAL_LINK_SECRET=
# Weave/cleanup pass: claude (default, best quote fidelity) | ollama (fully local).
WEAVE_PROVIDER=claude
ANTHROPIC_API_KEY=
# Ollama local fallback (only used when WEAVE_PROVIDER=ollama)
OLLAMA_URL=http://host.docker.internal:11434
WEAVE_OLLAMA_MODEL=llama3.1:8b
# faster-whisper (worker). large-v3 = best proper-noun accuracy (slower on CPU,
# fine for one entry/day); small.en/medium.en/distil-large-v3 are faster fallbacks.
WHISPER_MODEL=large-v3

# House email gateway (email-api). Unset → direct SMTP to SMTP_HOST.
EMAIL_API_URL=http://100.79.61.79:4500
EMAIL_API_KEY=
