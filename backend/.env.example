# Copy to .env.prod and fill in real values

# Set to "production" in .env.prod. When production, the app refuses to boot if
# JWT_SECRET / ADMIN_PASSWORD / MINIO secrets are left at defaults or empty.
ENVIRONMENT=development

TUNNEL_TOKEN=
JWT_SECRET=
ADMIN_USERNAME=nathan
ADMIN_PASSWORD=

# Login brute-force throttle (per IP). Defaults: 10 attempts / 900s.
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=900

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Existing KPI dashboard key
KPI_API_KEY=

# Umami analytics
UMAMI_BASE_URL=http://localhost:3333
UMAMI_WEBSITE_ID=
UMAMI_USERNAME=admin
UMAMI_PASSWORD=

# Health ingest endpoint
HEALTH_INGEST_API_KEY=your-secret-key-here
DATABASE_URL_KPI=postgresql://postgres:postgres@host.docker.internal:5432/kpi

# Daily voice journal
# Separate `journal` DB on the shared Postgres (auto-created on boot).
DATABASE_URL_JOURNAL=postgresql://postgres:postgres@host.docker.internal:5432/journal
# HMAC secret for the nightly magic link. Falls back to CHURCH_LINK_SECRET if unset.
JOURNAL_LINK_SECRET=
# Weave/cleanup pass: claude (default, best quote fidelity) | ollama (fully local).
WEAVE_PROVIDER=claude
ANTHROPIC_API_KEY=
# Ollama local fallback (only used when WEAVE_PROVIDER=ollama)
OLLAMA_URL=http://host.docker.internal:11434
WEAVE_OLLAMA_MODEL=llama3.1:8b
# faster-whisper (worker) — model size/device/compute type
WHISPER_MODEL=small.en
