<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Native MLX Whisper transcription service for the journal worker.
  Runs on the Mac mini HOST (not Docker) so it can use the M4 GPU. The Dockerized
  journal-worker POSTs audio to http://host.docker.internal:4310/transcribe.

  Install:  backend/deploy/install-journal-mlx.sh
  Logs:     /tmp/journal-mlx.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nathanblatter.journal-mlx</string>

    <!-- Runs from ~/journal-mlx (the installer copies journal_mlx_server.py there).
         Never point runtime paths at ~/Desktop/~/Documents: iCloud Drive evicts
         files and Python dies with EDEADLK ("Resource deadlock avoided"). -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/nathanblatter/journal-mlx/venv/bin/python</string>
        <string>-m</string>
        <string>journal_mlx_server</string>
    </array>

    <!-- cwd is put on sys.path[0] by `python -m`, so `journal_mlx_server` resolves. -->
    <key>WorkingDirectory</key>
    <string>/Users/nathanblatter/journal-mlx</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- /opt/homebrew/bin is required: mlx_whisper shells out to `ffmpeg` to decode audio. -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <!-- Loopback only: the LAN is a shared building segment. Docker Desktop's
             host.docker.internal reaches loopback-bound host services, so the
             journal-worker container is unaffected. -->
        <key>MLX_HOST</key>
        <string>127.0.0.1</string>
        <key>MLX_PORT</key>
        <string>4310</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/journal-mlx.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/journal-mlx.log</string>
</dict>
</plist>
