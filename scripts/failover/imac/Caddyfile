# Static failover mirror of nathanblatter.com, served on the iMac NAS.
# Populated daily by scripts/failover-snapshot.sh (rsync → ./www).
:8088 {
	root * /srv/www
	encode gzip zstd

	# Mirrored object-storage assets (images, PDFs, video) — served as real
	# files so Caddy sets the right content-type by extension. Must precede the
	# JSON handler below (which would otherwise force application/json).
	handle /api/v1/storage/download/* {
		file_server
	}

	# Mirrored public API snapshots. Stored as <path>.json; map the
	# extension-less request path to the file. A path that wasn't mirrored
	# simply 404s; the SPA's fetch-error handling degrades to skeletons.
	handle /api/* {
		try_files {path} {path}.json
		header Content-Type application/json
		file_server
	}

	# SPA: serve the requested asset, else fall back to index.html (history routing).
	handle {
		try_files {path} /index.html
		file_server
	}
}
